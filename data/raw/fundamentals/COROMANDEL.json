 soil and leaf testing services. The company also provides value-added services, including drone spraying, soil testing, crop diagnostics, and weather insights, as well as e-commerce platform for advisory and ordering. In addition, it operates an e-commerce platform for advisory and ordering services. The company was formerly known as Coromandel Fertilisers Ltd and changed its name to Coromandel International Limited in September 2009. Coromandel International Limited was founded in 1901 and is based in Chennai, India. Coromandel International Limited operates as a subsidiary of E.I.D.- Parry (India) Limited.","beta":0.134,"sharesOutstanding":294541099,"marketCap":587903991808,"trailingPE":37.7102,"forwardPE":22.0471,"priceToBook":4.3832,"enterpriseToEbitda":19.057,"dividendYield":0.55,"heldPercentInsiders":0.5954,"heldPercentInstitutions":0.2689,"earningsGrowth":-0.336,"revenueGrowth":0.066,"website":"https://www.coromandel.biz","fullTimeEmployees":6299,"recommendationKey":"strong_buy","targetMeanPrice":2325.889,"numberOfAnalystOpinions":9,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":64.0778,"low":52.4,"high":80.8,"yearAgoEps":66.31,"numberOfAnalysts":9.0,"growth":-0.0337,"currency":"INR","methodology":"normalized"},"+1y":{"avg":90.5333,"low":81.1,"high":101.8,"yearAgoEps":64.0778,"numberOfAnalysts":9.0,"growth":0.4129,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":107672000000.0,"low":107672000000.0,"high":107672000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":87794500000.0,"growth":0.2264,"currency":"INR"},"+1q":{"avg":75911000000.0,"low":75911000000.0,"high":75911000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":60036600000.0,"growth":0.2644,"currenc