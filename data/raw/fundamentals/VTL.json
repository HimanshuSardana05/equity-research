erformance, easy care stretchable, sustainable blended and slub, textured slub, cloud soft, and linen-luxe yarns; fabrics, such as piece dyed, yarn dyed, printed, fiber blends, weaved, and specialty finishes; acrylic fibers; and formal and casual shirts, including post cure and taped shirts. It is also involved in lending and investing activities. In addition, the company provides hot rolled bars, and special and alloy steel products, including carbon steel, case hardening steel, hardening steel, and other products for the automotive, engineering, bearing, and allied industries. It exports its products. The company was formerly known as Mahavir Spinning Mills Limited and changed its name to Vardhman Textiles Limited in September 2006. Vardhman Textiles Limited was founded in 1965 and is headquartered in Ludhiana, India.","beta":0.268,"sharesOutstanding":289475800,"marketCap":152930058240,"trailingPE":15.0427,"forwardPE":12.3627,"priceToBook":1.3608,"enterpriseToEbitda":8.864,"dividendYield":0.95,"heldPercentInsiders":0.6551,"heldPercentInstitutions":0.1602,"earningsGrowth":0.903,"revenueGrowth":0.155,"website":"https://www.vardhman.com","fullTimeEmployees":24097,"recommendationKey":"hold","targetMeanPrice":585.3333,"numberOfAnalystOpinions":6,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":42.6,"low":40.0,"high":48.0,"yearAgoEps":26.18,"numberOfAnalysts":6.0,"growth":0.6272,"currency":"INR","methodology":"normalized"},"+1y":{"avg":42.7333,"low":34.2,"high":51.0,"yearAgoEps":42.6,"numberOfAnalysts":6.0,"growth":0.0031,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":28059000000.0,"low":28059000000.0,"high":28059000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue"