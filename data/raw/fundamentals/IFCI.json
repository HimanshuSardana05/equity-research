 merchant banking, insurance corporate agency, mutual fund products distribution, and corporate advisory services. It also provides financial support services for airports, roads, telecom, power, real estate, manufacturing, and services sectors, as well as other allied industries. The company was formerly known as Industrial Finance Corporation of India and changed its name to IFCI Limited in October 1999. IFCI Limited was founded in 1948 and is headquartered in New Delhi, India.","beta":0.755,"sharesOutstanding":2694314331,"marketCap":167613284352,"trailingPE":92.8507,"forwardPE":17.6733,"priceToBook":1.839,"dividendYield":0.0,"heldPercentInsiders":0.7314,"heldPercentInstitutions":0.0358,"earningsGrowth":-0.2,"revenueGrowth":-0.063,"website":"https://www.ifciltd.com","fullTimeEmployees":114,"recommendationKey":"none","financialCurrency":"INR"},"estimates":{"eps":null,"revenue":{"0q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0},"+1q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0},"0y":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0},"+1y":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0}},"growth":{"0q":{"stockTrend":null,"indexTrend":0.2918},"+1q":{"stockTrend":null,"indexTrend":0.2713},"0y":{"stockTrend":null,"indexTrend":0.3333},"+1y":{"stockTrend":null,"indexTrend":0.1667},"LTG":{"stockTrend":null,"indexTrend":0.122}},"next_earnings":[],"surprises":[{"date":"2015-05-26","estimate":1.01,"reported":0.72,"surprise_pct":-28.71},{"date":"2015-02-02","estimate":1.08,"reported":0.8,"surprise_pct":-25.93},{"date":"2014-08-19","estimate":0.58,"reported":0.57,"surprise_pct":-1.72},{"date":"2014-04-29","estimate":1.16,"reported":1.02,"surprise_pct":-12.07}]}}