ard contracts, options, and swaps; term loans, project finance, bill discounting, working capital loans, packing credit limit, PCFC, and EBRD; bank guarantee, LC bill discounting, merchant banking services, cash management services, and Fed eSCF; and transaction banking services. Further, it provides payment and collection services; online and e-commerce services; and internet banking, mobile banking, conversational banking, ATMs, and open banking. The company was formerly known as Travancore Federal Bank Limited and changed its name to The Federal Bank Limited in March 1947. The Federal Bank Limited was incorporated in 1931 and is headquartered in Aluva, India.","beta":0.217,"sharesOutstanding":2470901462,"marketCap":889524518912,"trailingPE":17.5781,"forwardPE":14.561,"priceToBook":2.0789,"dividendYield":0.33,"heldPercentInsiders":0.1105,"heldPercentInstitutions":0.6011,"earningsGrowth":0.455,"revenueGrowth":0.364,"website":"https://www.federal.bank.in","fullTimeEmployees":16941,"recommendationKey":"buy","targetMeanPrice":370.3529,"numberOfAnalystOpinions":34,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":5.455,"low":5.38,"high":5.53,"yearAgoEps":4.19,"numberOfAnalysts":2.0,"growth":0.3019,"currency":"INR","methodology":"normalized"},"+1q":{"avg":6.13,"low":5.91,"high":6.35,"yearAgoEps":5.05,"numberOfAnalysts":2.0,"growth":0.2139,"currency":"INR","methodology":"normalized"},"0y":{"avg":21.2519,"low":18.3,"high":23.3,"yearAgoEps":16.56,"numberOfAnalysts":34.0,"growth":0.2833,"currency":"INR","methodology":"normalized"},"+1y":{"avg":24.6323,"low":20.3,"high":27.7373,"yearAgoEps":21.1465,"numberOfAnalysts":31.0,"growth":0.1648,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":45279865000.0,"low":45159730000.0,"high":45400000000.0,"numberOfAnalysts":2.0,"yearAgoRevenue":37530200000.0,"growth":0.2065,"currency":"INR"},"+1q":{"avg":48404839000.0,"low":48109678000.0,"high":48700000000.0,"numberOfAnalysts":2.0,"yearAgoRevenue":43175600000.0,