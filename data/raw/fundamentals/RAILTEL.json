sed services, and eNivida. It also provides optic fiber network services; internet service provider services through wireless infrastructure and other telecommunication networks; information and communication technology (ICT) services, including connectivity and cloud services; and maintenance services for telecom infrastructure. In addition, the company provides project services, including station Wi-Fi, hospital management information systems, BharatNet, National Knowledge Network, video surveillance systems, and railway signaling works; telecom and IT services-related projects; and enterprise-specific IT and ITES projects. It serves government organizations, ministries, educational institutions, corporates, retail customers, banks, NBFCs, and private enterprises. The company exports its services. RailTel Corporation of India Limited was incorporated in 2000 and is based in New Delhi, India.","beta":0.78,"sharesOutstanding":320938407,"marketCap":81768685568,"trailingPE":24.1498,"forwardPE":17.332,"priceToBook":3.4596,"enterpriseToEbitda":11.995,"dividendYield":1.28,"heldPercentInsiders":0.7284,"heldPercentInstitutions":0.0304,"earningsGrowth":-0.097,"revenueGrowth":0.205,"website":"https://www.railtel.in","fullTimeEmployees":595,"recommendationKey":"underperform","targetMeanPrice":223.0,"numberOfAnalystOpinions":2,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":12.85,"low":12.6,"high":13.1,"yearAgoEps":11.3497,"numberOfAnalysts":2.0,"growth":0.1322,"currency":"INR","methodology":"normalized"},"+1y":{"avg":14.7,"low":14.5,"high":14.9,"yearAgoEps":12.85,"numberOfAnalysts":2.0,"growth":0.144,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":0.0,"low":0.0,"high