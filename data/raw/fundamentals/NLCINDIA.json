 annum (MTPA) in Tamil Nadu and 30.10 MTPA in Rajasthan; and has total coal mining capacity of 20.00 MTPA. In addition, the company provides consultancy services to the mining sector and firms in the solar power generation sector. Further, it has a total installed thermal power generation capacity of 5,300 MW; and renewable energy generation capacity of 1,785 MW. It serves state distribution firms, commercial enterprises, and industrial and power consumers. The company was formerly known as Neyveli Lignite Corporation Limited and changed its name to NLC India Limited in April 2016. The company was incorporated in 1956 and is based in Cuddalore, India.","beta":0.568,"sharesOutstanding":1386636609,"marketCap":330019536896,"trailingPE":8.2869,"forwardPE":8.5921,"priceToBook":1.4103,"enterpriseToEbitda":9.894,"dividendYield":0.74,"heldPercentInsiders":0.7252,"heldPercentInstitutions":0.1499,"earningsGrowth":1.075,"revenueGrowth":0.133,"website":"https://www.nlcindia.in","fullTimeEmployees":9735,"recommendationKey":"strong_buy","targetMeanPrice":350.0,"numberOfAnalystOpinions":1,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":19.6,"low":19.6,"high":19.6,"yearAgoEps":25.4,"numberOfAnalysts":1.0,"growth":-0.2283,"currency":"INR","methodology":"normalized"},"+1y":{"avg":27.7,"low":27.7,"high":27.7,"yearAgoEps":19.6,"numberOfAnalysts":1.0,"growth":0.4133,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"+1q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"0y":{"avg":200630000000.0,"low":200630000000.0,"hig