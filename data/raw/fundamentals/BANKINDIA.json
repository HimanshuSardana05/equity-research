ational pension system, departmentalized ministries, sovereign and RBI bond, mahila samman savings certificate, and other schemes; mutual funds; and life, health, and general insurance products. Further, it provides NRI services, such as accounts, loans, and money remittance and ancillary services; kisan credit card; gold loans; self-help group; Atmanirbhar schemes; tractor/farm mechanization; food and agro loans; agri allied activities; kisan ghar and agri mortgage loan; agri clinic/agri business centers; and other loans services. Additionally, it offers internet banking, mobile banking, and payment services. The company was incorporated in 1906 and is headquartered in Mumbai, India.","beta":0.685,"sharesOutstanding":4552667866,"marketCap":739808509952,"trailingPE":5.9134,"forwardPE":6.2219,"priceToBook":0.7864,"dividendYield":2.86,"heldPercentInsiders":0.7338,"heldPercentInstitutions":0.145,"earningsGrowth":0.284,"revenueGrowth":0.174,"website":"https://bankofindia.bank.in","fullTimeEmployees":51010,"recommendationKey":"none","targetMeanPrice":151.0,"numberOfAnalystOpinions":4,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":3.62,"low":3.62,"high":3.62,"yearAgoEps":5.94,"numberOfAnalysts":1.0,"growth":-0.3906,"currency":"INR","methodology":"normalized"},"+1q":{"avg":3.29,"low":3.29,"high":3.29,"yearAgoEps":6.62,"numberOfAnalysts":1.0,"growth":-0.503,"currency":"INR","methodology":"normalized"},"0y":{"avg":26.7333,"low":25.8,"high":28.0,"yearAgoEps":23.12,"numberOfAnalysts":3.0,"growth":0.1563,"currency":"INR","methodology":"normalized"},"+1y":{"avg":26.1175,"low":18.27,"high":30.0,"yearAgoEps":26.7333,"numberOfAnalysts":4.0,"growth":-0.023,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"+1q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"0y":{"avg":396638666670.0,"low":3