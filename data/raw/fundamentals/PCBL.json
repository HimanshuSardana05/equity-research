lar weight polymers, tetrasodium glutamate diacetate, methylglycinediacetic acid, imidazoline, triazine, quaternary ammonium chlorides, biocides, and other downstream chemicals. Further, the company generates and distributes electricity from the tail gas recovered from carbon black production. Additionally, it develops nano-silicon additives used in the anode of lithium-ion batteries. The company was formerly known as PCBL Limited and changed its name to PCBL Chemical Limited in October 2024. PCBL Chemical Limited was incorporated in 1960 and is based in Kolkata, India.","beta":0.669,"sharesOutstanding":393462604,"marketCap":111467945984,"trailingPE":40.704,"forwardPE":19.039,"priceToBook":2.7533,"enterpriseToEbitda":15.472,"dividendYield":1.59,"heldPercentInsiders":0.0703,"heldPercentInstitutions":0.6476,"earningsGrowth":0.16,"revenueGrowth":0.144,"website":"https://www.pcblltd.com","fullTimeEmployees":1350,"recommendationKey":"hold","targetMeanPrice":348.7273,"numberOfAnalystOpinions":11,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":2.9128,"low":2.9128,"high":2.9128,"yearAgoEps":0.05,"numberOfAnalysts":1.0,"growth":57.2556,"currency":"INR","methodology":"normalized"},"+1q":{"avg":6.9149,"low":6.9149,"high":6.9149,"yearAgoEps":1.02,"numberOfAnalysts":1.0,"growth":5.7793,"currency":"INR","methodology":"normalized"},"0y":{"avg":10.675,"low":8.8,"high":12.7,"yearAgoEps":5.13,"numberOfAnalysts":8.0,"growth":1.0809,"currency":"INR","methodology":"normalized"},"+1y":{"avg":14.88,"low":12.6,"high":18.2,"yearAgoEps":10.6222,"numberOfAnalysts":10.0,"growth":0.4008,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":25467000000.0,"low":25467000000.0,"high":25467000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":18460000000.0,"growth":0.3796,"currency":"INR"},"+1q":{"avg":26922000000.0,"low":26922000000.0,"high":26922000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":20660600000.0,"growth":0.3031,"currency":"INR"},"0y":{"avg":100209933550.0,"low":933