ll payment; money transfer; NRI services; merchant solutions comprising POS terminal, payment gateway, digital rupee, and soundbox; transaction banking services, including trade finance, cash management, and tax payment; supply chain finance solutions, including supplier/vendor finance, channel finance, and receivable finance/factoring solutions; investment banking services consisting of debt syndication, debt and private equity fund-raising advisory, and M&A advisory; and inclusive banking. IndusInd Bank Limited was incorporated in 1994 and is headquartered in Mumbai, India.","beta":0.499,"sharesOutstanding":779144712,"marketCap":712449916928,"trailingPE":23.7815,"forwardPE":11.1711,"priceToBook":1.0488,"dividendYield":0.16,"heldPercentInsiders":0.1634,"heldPercentInstitutions":0.5622,"revenueGrowth":0.631,"website":"https://www.indusind.bank.in","fullTimeEmployees":46778,"recommendationKey":"hold","targetMeanPrice":964.0541,"numberOfAnalystOpinions":37,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":13.685,"low":11.32,"high":16.05,"yearAgoEps":2.0,"numberOfAnalysts":2.0,"growth":5.8425,"currency":"INR","methodology":"normalized"},"+1q":{"avg":15.38,"low":13.12,"high":17.64,"yearAgoEps":6.84,"numberOfAnalysts":2.0,"growth":1.2485,"currency":"INR","methodology":"normalized"},"0y":{"avg":59.2116,"low":50.2,"high":67.8095,"yearAgoEps":11.98,"numberOfAnalysts":25.0,"growth":3.9425,"currency":"INR","methodology":"normalized"},"+1y":{"avg":81.8542,"low":62.18,"high":97.6,"yearAgoEps":59.2116,"numberOfAnalysts":25.0,"growth":0.3824,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":68533422999.0,"low":68100000000.0,"high":68966846000.0,"numberOfAnalysts":2.0,"yearAgoRevenue":62681600000.0,"growth":0.0934,"currency":"INR"},"+1q":{"avg":70870700500.0,"low":70641401000.0,"high":71100000000.0,"numberOfAnalysts":2.0,"yearAgoRevenue":60778300000.0,"growth":0.1661,"currency":"INR"},"0y":{"avg":272920838930.0,"low":266000000000.0,"high":280809000000.0