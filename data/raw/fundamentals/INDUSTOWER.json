tional institutions, municipalities, households, transportation authorities, and private enterprises. The company also provides smart digital infrastructure, which includes smart poles LED lights, CCTV cameras, variable digital messaging board, environment sensors, and city public Wi-Fi services, including fiber backbone. In addition, it offers grid energy, diesel, and renewable energy and energy storage; small cells, fibre to the home, and one web; in-building solutions; and other projects. The company was formerly known as Bharti Infratel Limited and changed its name to Indus Towers Limited in December 2020. Indus Towers Limited was incorporated in 2006 and is based in Gurugram, India. Indus Towers Limited operates as a subsidiary of Bharti Airtel Limited.","beta":0.181,"sharesOutstanding":2637976089,"marketCap":1003090411520,"trailingPE":14.1095,"forwardPE":12.5246,"priceToBook":2.5411,"enterpriseToEbitda":7.866,"dividendYield":3.62,"heldPercentInsiders":0.513,"heldPercentInstitutions":0.3463,"earningsGrowth":-0.024,"revenueGrowth":0.04,"website":"https://www.industowers.com","fullTimeEmployees":3891,"recommendationKey":"hold","targetMeanPrice":431.4167,"numberOfAnalystOpinions":24,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":7.1978,"low":7.12,"high":7.246,"yearAgoEps":6.73,"numberOfAnalysts":3.0,"growth":0.0695,"currency":"INR","methodology":"normalized"},"+1q":{"avg":7.3244,"low":7.24,"high":7.4167,"yearAgoEps":6.8,"numberOfAnalysts":3.0,"growth":0.0771,"currency":"INR","methodology":"normalized"},"0y":{"avg":27.9139,"low":27.0175,"high":30.6,"yearAgoEps":27.09,"numberOfAnalysts":22.0,"growth":0.0304,"currency":"INR","methodology":"normalized"},"+1y":{"avg":30.3603,"low":27.2,"high":34.7,"yearAgoEps":27.9139,"numberOfAnalysts":22.0,"growth":0.0876,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":86249130000.0,"low":85700000000.0,"high":86798260000.0,"numberOfAnalysts":2.0,"yearAgoRevenue":81463000000.0,"growth":0.0588,"currency