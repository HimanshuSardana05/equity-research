y butene feedstock (PBFS), methyl ethyl ketone feedstock, and kerosene supply. Further, it provides asphalt, linear alkyl benzene feedstock, butene-2, lean butene, lean PBFS, isrosene, ISRO naphtha, propylene, butylene feedstock, and missile fuels. The company was formerly known as Madras Refineries Limited and changed its name to Chennai Petroleum Corporation Limited in June 2000. The company was incorporated in 1965 and is based in Chennai, India. Chennai Petroleum Corporation Limited operates as a subsidiary of Indian Oil Corporation Limited.","beta":0.011,"sharesOutstanding":148911400,"marketCap":212794376192,"trailingPE":3.732,"forwardPE":4.0322,"priceToBook":1.5654,"enterpriseToEbitda":2.67,"dividendYield":5.53,"heldPercentInsiders":0.688,"heldPercentInstitutions":0.0587,"earningsGrowth":2.124,"revenueGrowth":0.259,"website":"https://www.cpcl.co.in","fullTimeEmployees":1403,"recommendationKey":"none","targetMeanPrice":1885.0,"numberOfAnalystOpinions":1,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"numberOfAnalysts":null,"yearAgoEps":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"numberOfAnalysts":null,"yearAgoEps":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":547.8,"low":547.8,"high":547.8,"numberOfAnalysts":1.0,"yearAgoEps":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1y":{"avg":354.4,"low":354.4,"high":354.4,"numberOfAnalysts":1.0,"yearAgoEps":547.8,"growth":-0.353,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"+1q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"0y":{"avg":901373000000.0,"low":901373000000.0,"high":901373000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"+1y":{"avg":773794