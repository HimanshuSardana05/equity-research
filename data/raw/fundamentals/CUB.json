nd mobile banking; cash and wealth management; electronic fund transfer; green pins; wallet; point of sale; and automated teller machines, as well as demat, bill payment, GST and tax payments, and digital signature services. In addition, the company offers payments to government, including online taxes and electricity bill payment; agri related information, academic, and kiosk services; and safe deposit locker facilities, 24/7 customer care, value added services, and account aggregator services. The company was formerly known as The Kumbakonam City Union Bank Limited and changed its name to City Union Bank Limited in December 1987. City Union Bank Limited was incorporated in 1904 and is based in Kumbakonam, India.","beta":0.351,"sharesOutstanding":990787237,"marketCap":230258950144,"trailingPE":14.3812,"forwardPE":11.681,"priceToBook":2.0562,"dividendYield":0.86,"heldPercentInsiders":0.092,"heldPercentInstitutions":0.5643,"earningsGrowth":0.267,"revenueGrowth":0.27,"website":"https://cityunionbank.bank.in","fullTimeEmployees":8894,"recommendationKey":"buy","targetMeanPrice":261.5652,"numberOfAnalystOpinions":23,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":16.7712,"low":15.6508,"high":17.8,"yearAgoEps":13.3725,"numberOfAnalysts":20.0,"growth":0.2542,"currency":"INR","methodology":"normalized"},"+1y":{"avg":19.8955,"low":17.724,"high":21.8,"yearAgoEps":16.7712,"numberOfAnalysts":22.0,"growth":0.1863,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"+1q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"IN