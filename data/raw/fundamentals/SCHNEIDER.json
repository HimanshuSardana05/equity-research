cts, such as EasyPact EXE, a vacuum circuit breaker; medium voltage switchgear; protection relays, distribution management systems and grid solutions, including self-healing networks; digital substation, as well as EcoStruxure grid, AI-powered, software-defined platform. In addition, the company provides partner managed, and field and automation services. It serves power generation, transmission, distribution, oil and gas, metro rail, mining, metals and other infrastructure sectors, including electro-intensive industries. The company was formerly known as Smartgrid Automation Distribution and Switchgear Limited and changed its name to Schneider Electric Infrastructure Limited in December 2011. The company was incorporated in 2011 and is based in Gurugram, India. Schneider Electric Infrastructure Limited is a subsidiary of Energy Grid Automation Transformers and Switchgears India Private Limited.","beta":0.472,"sharesOutstanding":239104035,"marketCap":243288358912,"trailingPE":150.9644,"forwardPE":46.3202,"priceToBook":29.7332,"enterpriseToEbitda":80.344,"dividendYield":0.0,"heldPercentInsiders":0.7694,"heldPercentInstitutions":0.0614,"earningsGrowth":-0.434,"revenueGrowth":0.198,"website":"https://infra-in.se.com","fullTimeEmployees":1447,"recommendationKey":"none","targetMeanPrice":1348.3334,"numberOfAnalystOpinions":3,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":2.2533,"low":1.6,"high":3.26,"yearAgoEps":2.19,"numberOfAnalysts":3.0,"growth":0.0289,"currency":"INR","methodology":"normalized"},"+1q":{"avg":7.01,"low":7.01,"high":7.01,"yearAgoEps":0.6488,"numberOfAnalysts":1.0,"growth":9.8046,"currency":"INR","methodology":"normalized"},"0y":{"avg":9.25,"low":8.8,"high":9.7,"yearAgoEps":9.322,"numberOfAnalysts":2.0,"growth":-0.0077,"currency":"INR","methodology":"normalized"},"+1y":{"avg":21.9667,"low":16.0,"high":32.8,"yearAgoEps":9.25,"numberOfAnalysts":3.0,"growth":1.3748,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":7945448000.