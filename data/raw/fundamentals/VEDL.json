 in the Chhattisgarh; 1,980 MW thermal coal- based commercial power facilities in Punjab; wind power plants; and a 1,000 MW coal-based power plant at Nellore, Andhra Pradesh. In addition, it manufactures and supplies billets, TMT bars, wire rods, and ductile iron pipes; mechanizes coal handling facilities and upgrades general cargo berth for handling coal at the outer harbor of Visakhapatnam Port on the east coast of India; offers port/berth services; and manufactures glass substrates, semiconductor, displays, ferro alloys, and slag cements. The company was formerly known as Sesa Sterlite Limited and changed its name to Vedanta Limited in March 2015. The company was founded in 1954 and is headquartered in Mumbai, India.","beta":0.426,"sharesOutstanding":3904801732,"marketCap":929342816256,"trailingPE":8.3479,"forwardPE":6.2144,"priceToBook":7.2807,"enterpriseToEbitda":3.398,"dividendYield":6.87,"heldPercentInsiders":0.5707,"heldPercentInstitutions":0.1797,"earningsGrowth":1.039,"revenueGrowth":-0.342,"website":"https://www.vedantalimited.com","fullTimeEmployees":16090,"recommendationKey":"buy","targetMeanPrice":302.2222,"numberOfAnalystOpinions":9,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":41.1194,"low":28.3,"high":64.3,"yearAgoEps":53.1125,"numberOfAnalysts":9.0,"growth":-0.2258,"currency":"INR","methodology":"normalized"},"+1y":{"avg":38.2984,"low":23.8,"high":56.46,"yearAgoEps":41.1194,"numberOfAnalysts":9.0,"growth":-0.0686,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":266400000000.0,"low":266400000000.0,"high":266400000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":466510000000.0,"growth":-0.429,"currency":"INR"},"+1q":{"avg":277600000000.0,"low"