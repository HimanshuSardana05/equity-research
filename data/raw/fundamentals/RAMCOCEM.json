 generation of power from windmills; manpower supply; transportation of goods by road; and information technology services. The company's products are used in construction applications for housing projects, apartments and institutions, public infrastructure projects, and industrial projects. The company serves the commercial and private sectors. It sells its products to the Maldives and Myanmar through direct and merchant exports. The company was formerly known as Madras Cements Ltd. and changed its name to The Ramco Cements Limited in July 2013. The Ramco Cements Limited was incorporated in 1957 and is headquartered in Chennai, India.","beta":0.143,"sharesOutstanding":236292380,"marketCap":193771569152,"trailingPE":31.8837,"forwardPE":32.3637,"priceToBook":2.3921,"enterpriseToEbitda":18.253,"dividendYield":0.31,"heldPercentInsiders":0.4919,"heldPercentInstitutions":0.3193,"earningsGrowth":-0.477,"revenueGrowth":0.1,"website":"https://www.ramcocements.in","fullTimeEmployees":3890,"recommendationKey":"hold","targetMeanPrice":931.4194,"numberOfAnalystOpinions":31,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":1.5,"low":1.5,"high":1.5,"yearAgoEps":0.2219,"numberOfAnalysts":1.0,"growth":5.7598,"currency":"INR","methodology":"normalized"},"+1q":{"avg":10.5,"low":10.5,"high":10.5,"yearAgoEps":3.5945,"numberOfAnalysts":1.0,"growth":1.9211,"currency":"INR","methodology":"normalized"},"0y":{"avg":13.3614,"low":10.2,"high":18.3,"yearAgoEps":10.9673,"numberOfAnalysts":17.0,"growth":0.2183,"currency":"INR","methodology":"normalized"},"+1y":{"avg":25.3386,"low":20.0,"high":31.393,"yearAgoEps":13.3614,"numberOfAnalysts":21.0,"growth":0.8964,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":24600000000.0,"low":24600000000.0,"high":24600000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":21014600000.0,"growth":0.1706,"currency":"INR"},"+1q":{"avg":30200000000.0,"low":30200000000.0,"high":30200000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":26061400000.0