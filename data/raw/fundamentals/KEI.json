 instrumentation cables, thermocouple extension/compensating cables, solar cables, rubber cables, fire survival/resistant cables, marine and offshore cables, winding wires, stainless steel wires, medium voltage covered conductors, and EV charging cables and guns. It also provides engineering, procurement, and construction solutions in the areas of gas-insulated GIS, and air-insulated substations AIS; overhead and underground power transmission and distribution systems; and railway electrification/substation on a turnkey basis, as well as project management services. The company exports its products to approximately 60 countries. It serves the power, infrastructure, real estate, refineries, oil & gas, defence, chemicals, metals, information technology, pharmaceuticals, manufacturing, renewable energy, cement, fertilizers, consumer durables, data centres, non-metal industries, and other sectors through dealers and distributors. The company was founded in 1968 and is headquartered in New Delhi, India.","beta":0.621,"sharesOutstanding":95645595,"marketCap":386408185856,"trailingPE":35.7585,"forwardPE":28.6506,"priceToBook":5.7949,"enterpriseToEbitda":28.67,"dividendYield":0.11,"heldPercentInsiders":0.3602,"heldPercentInstitutions":0.443,"earningsGrowth":0.4,"revenueGrowth":0.23,"website":"https://www.kei-ind.com","fullTimeEmployees":2197,"recommendationKey":"buy","targetMeanPrice":5097.609,"numberOfAnalystOpinions":23,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":32.2,"low":32.2,"high":32.2,"yearAgoEps":24.55,"numberOfAnalysts":1.0,"growth":0.3116,"currency":"INR","methodology":"normalized"},"+1q":{"avg":37.9,"low":37.9,"high":37.9,"yearAgoEps":29.72,"numberOfAnalysts":1.0,"growth":0.2752,"currency":"INR","methodology":"normalized"},"0y":{"avg":117.5455,"low":110.7,"high":128.0,"yearAgoEps":96.02,"numberOfAnalysts":14.0,"growth":0.2242,"currency":"INR","methodology":"normalized"},"+1y":{"avg":141.0092,"low":128.4889,"high":152.2,"yearAgoEps":117.5455,"numbe