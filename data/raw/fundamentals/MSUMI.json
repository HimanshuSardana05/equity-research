any offers digital assembly boards, color detection systems, component presence sensors, and online work instructions. Further, it manufactures wiring harnesses products for passenger cars; two-wheelers and recreational vehicles; heavy, medium, and light-duty commercial vehicles; motorcycles and three-wheelers; multi-utility vehicles; farm and material-handling equipment; and off-highway vehicles. Additionally, the company offers specialized wiring harnesses for consumer durables, office automation equipment, medical diagnostic equipment, and other electrical and electronic equipment. Motherson Sumi Wiring India Limited was incorporated in 2020 and is headquartered in Noida, India.","beta":0.032,"sharesOutstanding":6631661898,"marketCap":258966405120,"trailingPE":37.5481,"forwardPE":26.112,"priceToBook":11.9859,"enterpriseToEbitda":24.741,"dividendYield":1.49,"heldPercentInsiders":0.6175,"heldPercentInstitutions":0.2054,"earningsGrowth":0.36,"revenueGrowth":0.467,"website":"https://www.mswil.motherson.com","fullTimeEmployees":6463,"recommendationKey":"strong_buy","targetMeanPrice":48.5714,"numberOfAnalystOpinions":14,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":0.3,"low":0.3,"high":0.3,"yearAgoEps":0.23,"numberOfAnalysts":1.0,"growth":0.3043,"currency":"INR","methodology":"normalized"},"+1q":{"avg":0.3,"low":0.3,"high":0.3,"yearAgoEps":0.25,"numberOfAnalysts":1.0,"growth":0.2,"currency":"INR","methodology":"normalized"},"0y":{"avg":1.2075,"low":1.1,"high":1.3,"yearAgoEps":0.94,"numberOfAnalysts":13.0,"growth":0.2846,"currency":"INR","methodology":"normalized"},"+1y":{"avg":1.4955,"low":1.3,"high":1.7,"yearAgoEps":1.2075,"numberOfAnalysts":14.0,"growth":0.2384,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":40419000000.0,"low":40419000000.0,"high":40419000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":28870700000.0,"growth":0.4,"currency":"INR"},"+1q":{"avg":39917000000.0,"low":39917000000.0,"high":39917000000.0,"numberOfAnalysts":1.