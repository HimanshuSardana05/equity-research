ensity cabinets, fiber splice joint closures, ethernet cabling products, and active optical components; and defence solutions, including electro optics, electronic fuzes, ground surveillance radar, high-capacity radio relay, and software defined radios. It also provides network solutions for public telecommunications, defence and railway communications, and system integration services. The company was formerly known as Himachal Futuristic Communications Limited and changed its name to HFCL Limited in October 2019. HFCL Limited was incorporated in 1987 and is based in New Delhi, India.","beta":0.96,"sharesOutstanding":1530263663,"marketCap":314469187584,"trailingPE":35.8639,"forwardPE":24.759,"priceToBook":5.5703,"enterpriseToEbitda":21.474,"dividendYield":0.1,"heldPercentInsiders":0.3423,"heldPercentInstitutions":0.1979,"earningsGrowth":4.021,"revenueGrowth":1.436,"website":"https://www.hfcl.com","fullTimeEmployees":1820,"recommendationKey":"none","targetMeanPrice":280.0,"numberOfAnalystOpinions":2,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"+1q":{"avg":null,"low":null,"high":null,"yearAgoEps":null,"numberOfAnalysts":null,"growth":null,"currency":"INR","methodology":"normalized"},"0y":{"avg":8.5,"low":8.5,"high":8.5,"yearAgoEps":2.13,"numberOfAnalysts":1.0,"growth":2.9906,"currency":"INR","methodology":"normalized"},"+1y":{"avg":8.3,"low":5.2,"high":11.4,"yearAgoEps":8.5,"numberOfAnalysts":2.0,"growth":-0.0235,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"+1q":{"avg":0.0,"low":0.0,"high":0.0,"numberOfAnalysts":0.0,"yearAgoRevenue":null,"growth":null,"currency":"INR"},"0y":{"avg":92337000000.0,"low":92337000000.0,"high":92337000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":49492700000.0,"growth":0.865