ineering, AI and machine learning, automation, and visualization and analytics; and application management, quality engineering, enterprise change management, Oracle, salesforce, SAP, and veeva services. In addition, the company offers cloud infrastructure and security solutions, such as cloud, hybrid infrastructure, digital workplace, enterprise system management, and security; AI solutions; and brand strategy and design, consulting, and marketing and insights solutions. It serves manufacturing, retail, media, technology and telecom, consumer service, banking and financial service, insurance, healthcare and life sciences, public sector, and utilities industries. Zensar Technologies Limited was formerly known as Fujitsu ICIM Limited and changed its name to Zensar Technologies Limited in August 2001. Zensar Technologies Limited was incorporated in 1963 and is headquartered in Pune, India.","beta":0.081,"sharesOutstanding":227136897,"marketCap":125947412480,"trailingPE":16.2182,"forwardPE":14.495,"priceToBook":2.6,"enterpriseToEbitda":11.023,"dividendYield":2.81,"heldPercentInsiders":0.5008,"heldPercentInstitutions":0.2674,"earningsGrowth":0.044,"revenueGrowth":0.115,"website":"https://www.zensar.com","fullTimeEmployees":10066,"recommendationKey":"none","targetMeanPrice":600.5,"numberOfAnalystOpinions":12,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":8.45,"low":8.2,"high":8.7,"yearAgoEps":9.6667,"numberOfAnalysts":2.0,"growth":-0.1259,"currency":"INR","methodology":"normalized"},"+1q":{"avg":8.7667,"low":8.3,"high":9.2,"yearAgoEps":9.1334,"numberOfAnalysts":3.0,"growth":-0.0402,"currency":"INR","methodology":"normalized"},"0y":{"avg":33.2818,"low":32.3,"high":34.3,"yearAgoEps":34.5111,"numberOfAnalysts":11.0,"growth":-0.0356,"currency":"INR","methodology":"normalized"},"+1y":{"avg":38.2546,"low":35.5,"high":40.5,"yearAgoEps":33.2818,"numberOfAnalysts":11.0,"growth":0.1494,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":16106000000.0,"