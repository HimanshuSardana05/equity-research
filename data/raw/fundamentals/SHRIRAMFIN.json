s services, such as electricity, LPG gas, gas bill payment, broadband postpaid, water, and cable tv; financial services and taxes comprising credit card, loan repayment, insurance, municipal services, and recurring deposit; and other services, such as housing society, clubs and associations, and education fees. It serves first time buyers, small road transport operators, commercial vehicles operators, micro, small, and medium enterprises (MSMEs), and individuals. The company was formerly known as Shriram Transport Finance Company Limited and changed its name to Shriram Finance Limited in November 2022. Shriram Finance Limited was incorporated in 1979 and is based in Mumbai, India.","beta":0.668,"sharesOutstanding":2353086792,"marketCap":2282494099456,"trailingPE":16.1667,"forwardPE":13.7276,"priceToBook":2.0477,"dividendYield":1.29,"heldPercentInsiders":0.2217,"heldPercentInstitutions":0.5962,"earningsGrowth":0.274,"revenueGrowth":0.379,"website":"https://shriramfinance.in","fullTimeEmployees":82292,"recommendationKey":"strong_buy","targetMeanPrice":1127.1177,"numberOfAnalystOpinions":34,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":15.85,"low":15.85,"high":15.85,"yearAgoEps":13.39,"numberOfAnalysts":1.0,"growth":0.1837,"currency":"INR","methodology":"normalized"},"+1q":{"avg":15.96,"low":15.96,"high":15.96,"yearAgoEps":16.01,"numberOfAnalysts":1.0,"growth":-0.0031,"currency":"INR","methodology":"normalized"},"0y":{"avg":65.6272,"low":65.6272,"high":70.2,"yearAgoEps":53.25,"numberOfAnalysts":32.0,"growth":0.2324,"currency":"INR","methodology":"normalized"},"+1y":{"avg":70.6605,"low":70.1184,"high":77.5,"yearAgoEps":65.6272,"numberOfAnalysts":33.0,"growth":0.0767,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":91672000000.0,"low":91672000000.0,"high":91672000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":69324800000.0,"growth":0.3224,"currency":"INR"},"+1q":{"avg":94026000000.0,"low":94026000000.0,"high":94026000000.0,"numberOfAnalyst