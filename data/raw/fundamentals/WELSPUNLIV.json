 fashion bedding, and bed sheets; mats, carpet tiles, broadloom, area rugs, artificial turf, wall to wall carpets, SPC tiles, and artificial grass; and wet wipes, beaty sheet masks, and other nonwoven fabrics. It also engages in the power generation, real estate, and industrial park development businesses, as well as trading of home textile products. The company sells its products under the owned and licensed brands, such as Christy, Spaces, Welspun, Welspun Flooring, SPUN, Welhome, and Martha Stewart. It sells its products through online and offline stores. The company was formerly known as Welspun India Limited and changed its name to Welspun Living Limited in September 2023. Welspun Living Limited was incorporated in 1985 and is headquartered in Mumbai, India. Welspun Living Limited is a subsidiary of Welspun Group Master Trust.","beta":0.24,"sharesOutstanding":941445014,"marketCap":263934115840,"trailingPE":61.3457,"forwardPE":29.1515,"priceToBook":5.1988,"enterpriseToEbitda":25.512,"dividendYield":0.04,"heldPercentInsiders":0.6637,"heldPercentInstitutions":0.1786,"earningsGrowth":12.846,"revenueGrowth":0.163,"website":"https://www.welspunliving.com","fullTimeEmployees":40000,"recommendationKey":"strong_buy","targetMeanPrice":278.4,"numberOfAnalystOpinions":10,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":1.9,"low":1.9,"high":1.9,"yearAgoEps":0.15,"numberOfAnalysts":1.0,"growth":11.6667,"currency":"INR","methodology":"normalized"},"+1q":{"avg":2.1,"low":2.1,"high":2.1,"yearAgoEps":1.08,"numberOfAnalysts":1.0,"growth":0.9444,"currency":"INR","methodology":"normalized"},"0y":{"avg":6.82,"low":6.6,"high":7.2,"yearAgoEps":2.29,"numberOfAnalysts":9.0,"growth":1.9782,"currency":"INR","methodology":"normalized"},"+1y":{"avg":9.617,"low":8.5,"high":10.7,"yearAgoEps":6.82,"numberOfAnalysts":10.0,"growth":0.4101,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":26608000000.0,"low":26608000000.0,"high":26608000000.0,"numberOfAnalysts":1.0,"y