ally. The company provides IMFL products in various categories of whisky, vodka, rum, gin, brandy, and liqueurs, as well as ethanol. It also provides bottling services to other spirit manufacturers. The company offers its products under the 8PM Whisky, Magic Moments Vodka, Old Admiral Brandy, 8PM Premium Black Whisky, Morpheus Brandy, Contessa Rum, 1965 Spirit of Victory Rum and After Dark Whisky, Rampur Indian Single Malt Whisky, Jaisalmer Indian Craft Gin, Magic Moments Verve Vodka, Morpheus Premium and Morpheus Blue Super Premium Brandy, Pluton Bay Rum, Regal Talon Whisky, and Whytehall Brandy brand names. It offers its products to state government, state-owned enterprises, canteen stores department, private wholesalers, distributors, retailers, hotels, clubs, and restaurants. The company was formerly known as Rampur Distillery Company. Radico Khaitan Limited was founded in 1943 and is based in New Delhi, India.","beta":0.521,"sharesOutstanding":133989065,"marketCap":617019670528,"trailingPE":76.9038,"forwardPE":55.4819,"priceToBook":16.8136,"enterpriseToEbitda":50.899,"dividendYield":0.2,"heldPercentInsiders":0.4285,"heldPercentInstitutions":0.318,"earningsGrowth":0.663,"revenueGrowth":0.168,"website":"https://www.radicokhaitan.com","fullTimeEmployees":1543,"recommendationKey":"none","targetMeanPrice":4935.05,"numberOfAnalystOpinions":20,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":16.3,"low":16.3,"high":16.3,"yearAgoEps":12.1156,"numberOfAnalysts":1.0,"growth":0.3454,"currency":"INR","methodology":"normalized"},"+1q":{"avg":17.6,"low":17.6,"high":17.6,"yearAgoEps":13.08,"numberOfAnalysts":1.0,"growth":0.3456,"currency":"INR","methodology":"normalized"},"0y":{"avg":68.76,"low":66.9,"high":71.3,"yearAgoEps":45.9282,"numberOfAnalysts":15.0,"growth":0.4971,"currency":"INR","methodology":"normalized"},"+1y":{"avg":83.0,"low":76.9,"high":92.0,"yearAgoEps":68.76,"numberOfAnalysts":16.0,"growth":0.2071,"currency":"INR","methodology":"normalized"}},"revenu