 company also provides tile adhesives, gouts, cleaners, and fixing accessories; waterproof coatings, preformed membranes, and repair and integral waterproofing solutions; and ready-mix plasters and industrial and precision grouts. It also provides building solutions and support services; and infrastructure solutions, such as decorative, durability multiplayer, smart repair, advance structural, and floor and slab solutions. The company was formerly known as UltraTech CemCo Limited and changed its name to UltraTech Cement Limited in October 2004. UltraTech Cement Limited was incorporated in 2000 and is based in Mumbai, India. The company operates as a subsidiary of Grasim Industries Limited.","beta":0.462,"sharesOutstanding":294064622,"marketCap":3745500889088,"trailingPE":43.0711,"forwardPE":31.0553,"priceToBook":5.0916,"enterpriseToEbitda":22.463,"dividendYield":1.88,"heldPercentInsiders":0.6123,"heldPercentInstitutions":0.2343,"earningsGrowth":0.213,"revenueGrowth":0.188,"website":"https://www.ultratechcement.com","fullTimeEmployees":28399,"recommendationKey":"strong_buy","targetMeanPrice":13644.277,"numberOfAnalystOpinions":36,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":60.7,"low":60.7,"high":60.7,"yearAgoEps":60.9165,"numberOfAnalysts":1.0,"growth":-0.0036,"currency":"INR","methodology":"normalized"},"+1q":{"avg":91.05,"low":91.05,"high":91.05,"yearAgoEps":101.6302,"numberOfAnalysts":1.0,"growth":-0.1041,"currency":"INR","methodology":"normalized"},"0y":{"avg":324.3168,"low":275.91,"high":386.3,"yearAgoEps":280.9777,"numberOfAnalysts":32.0,"growth":0.1542,"currency":"INR","methodology":"normalized"},"+1y":{"avg":405.3735,"low":321.1,"high":477.7,"yearAgoEps":324.3168,"numberOfAnalysts":33.0,"growth":0.2499,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":277108000000.0,"low":277108000000.0,"high":277108000000.0,"numberOfAnalysts":1.0,"yearAgoRevenue":218296800000.0,"growth":0.2694,"currency":"INR"},"+1q":{"avg":334802000000.0,"l