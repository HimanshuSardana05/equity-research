le, and feature mobile phones; wireless wearables and hearables; computing devices; and telecommunication and networking products, which include 5G fixed wireless access devices, optical network terminals, and IPTV set-top boxes. In addition, the company is involved in the provision of electronic manufacturing services; trading; reverse logistics, such as repair and refurbishment of LED TV panels; repair of mobile phones; research and development; design and prototyping; manufacturing and assembly; and quality and performance. Further, it offers moulds, research and development lab equipment, basket assembly korean machines, jigs and fixtures, etc. The company exports its products. Dixon Technologies (India) Limited was incorporated in 1993 and is headquartered in Noida, India.","beta":-0.02,"sharesOutstanding":61170586,"marketCap":803659120640,"trailingPE":45.8569,"forwardPE":47.9619,"priceToBook":11.3883,"enterpriseToEbitda":37.723,"dividendYield":0.08,"heldPercentInsiders":0.4038,"heldPercentInstitutions":0.3755,"earningsGrowth":-0.451,"revenueGrowth":0.467,"website":"https://www.dixoninfo.com","fullTimeEmployees":1319,"recommendationKey":"buy","targetMeanPrice":14213.148,"numberOfAnalystOpinions":27,"financialCurrency":"INR"},"estimates":{"eps":{"0q":{"avg":41.5677,"low":41.5677,"high":41.5677,"yearAgoEps":52.62,"numberOfAnalysts":1.0,"growth":-0.21,"currency":"INR","methodology":"normalized"},"+1q":{"avg":41.5677,"low":41.5677,"high":41.5677,"yearAgoEps":48.81,"numberOfAnalysts":1.0,"growth":-0.1484,"currency":"INR","methodology":"normalized"},"0y":{"avg":168.7634,"low":140.9,"high":247.8937,"yearAgoEps":269.35,"numberOfAnalysts":26.0,"growth":-0.3734,"currency":"INR","methodology":"normalized"},"+1y":{"avg":273.9257,"low":218.7,"high":370.0,"yearAgoEps":168.7634,"numberOfAnalysts":27.0,"growth":0.6231,"currency":"INR","methodology":"normalized"}},"revenue":{"0q":{"avg":163777000000.0,"low":163777000000.0,"high":163777000000.0,"numberOfAnalysts":1.0,"yearAgoRev